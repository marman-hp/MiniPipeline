<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <AvaloniaVersion>12.1.5</AvaloniaVersion>
    <!-- The demo XAML uses reflection bindings; Avalonia 12 compiles bindings by default. -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>

    <!-- CefGlue.OSR (https://github.com/marman-hp/CefGlue.OSR); its packages ship in localnuget\ (see nuget.config). -->
    <CefGlueOSRVersion>154.8037.94</CefGlueOSRVersion>
    <!-- CefGlue.OSR checkout: only its cef\runtimes folder is used (the CEF binaries copied next to the demo apps). -->
    <CefGlueOSRDir Condition="'$(CefGlueOSRDir)' == ''">$(MSBuildThisFileDirectory)..\CefGlue.OSR\</CefGlueOSRDir>
  </PropertyGroup>
</Project>
