<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- CefGlue.OSR is not on nuget.org yet: its packages ship in localnuget\ (built from github.com/marman-hp/CefGlue.OSR). -->
    <add key="localnuget" value="localnuget" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="localnuget">
      <package pattern="CefGlue.OSR.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
