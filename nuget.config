<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- CefGlue.OSR packages are not on nuget.org yet: build CefGlue.OSR next to this repo, it packs into Nuget\output. -->
    <add key="CefGlue.OSR" value="..\CefGlue.OSR\Nuget\output" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="CefGlue.OSR">
      <package pattern="CefGlue.OSR.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
